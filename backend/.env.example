# Copy to .env and fill in to enable the live LLM agent.
# If left empty, the system automatically falls back to the rule-based agent
# so the demo still works fully offline.

# Reasoning + OCR layer. Provider precedence: Gemini → Anthropic → rule-based.
# Set ONE key. Gemini has a FREE tier (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional alternative provider (paid). Used only if GEMINI_API_KEY is unset.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Government Portal access code (officials' login). CHANGE THIS in production.
OFFICIAL_KEY=samadhan-admin

# Persistent database. Leave blank for local SQLite. In production set this to a
# hosted Postgres URL (Render / Neon / Supabase) so grievances + status survive
# restarts and redeploys. Accepts postgres:// or postgresql:// (auto-normalised).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
